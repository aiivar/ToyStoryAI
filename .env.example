# ToyStoryAI — пример конфигурации.
# Скопируйте в .env и заполните значения.

# --- MAX Bot API (обязательно) ---------------------------------------
# Токен бота получите у @MasterBot в MAX.
MAX_BOT_TOKEN=

# --- DeepSeek: генерация сказки --------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=60
DEEPSEEK_MAX_TOKENS=4096

# --- Gemini: генерация иллюстраций ------------------------------------
# Пустой GEMINI_API_KEY включает MockImageProvider (картинки без выплат).
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# Nano Banana 2 (семейство Gemini 3.1 Flash Image).
GEMINI_MODEL=gemini-3.1-flash-image
GEMINI_TIMEOUT=120

# --- Kling AI через GMI Cloud: генерация видео ------------------------
# Пустой KLING_API_KEY включает MockVideoProvider (тестовое видео).
KLING_API_KEY=
KLING_BASE_URL=https://api.gmi-serving.com/v1
KLING_MODEL=kling-v3-image-to-video
KLING_CREATE_PATH=/videos/image2video
KLING_STATUS_PATH=/videos/image2video/{request_id}
KLING_POLL_INTERVAL=10
KLING_MAX_WAIT=600
KLING_DURATION=5
KLING_MODE=std
KLING_RESOLUTION=720p
KLING_SOUND=false
KLING_TIMEOUT=120
MOCK_VIDEO_URL=https://example.com/mock/toy-story-preview.mp4

# --- Хранение ---------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./bot.db
UPLOADS_DIR=uploads

# --- Валидация фото ---------------------------------------------------
PHOTO_MAX_SIZE_MB=10
PHOTO_MIN_SIDE_PX=300
PHOTO_ASPECT_MIN=0.4
PHOTO_ASPECT_MAX=2.5

# --- Логирование ------------------------------------------------------
LOG_LEVEL=INFO

# --- Пайплайн сказок (app/story_pipeline) -----------------------------
STORY_DEFAULT_PAGES=6
STORY_PAGES_MIN=1
STORY_PAGES_MAX=12
STORY_MAX_REVISIONS=2
STORY_AGE_MIN=3
STORY_AGE_MAX=6
STORY_OUTPUT_DIR=output
