# ToyStoryAI — пример конфигурации.
# Скопируйте в .env и заполните значения.

# --- MAX Bot API (обязательно) ---------------------------------------
# Токен бота получите у @MasterBot в MAX.
MAX_BOT_TOKEN=
# Ожидание готовности вложения. MAX обрабатывает файлы асинхронно и до
# готовности отвечает attachment.not.ready; свежий mp3 на несколько минут
# обрабатывается около 10–15 с, поэтому бюджет по умолчанию 30 × 3 с ≈ 90 с.
MAX_UPLOAD_ATTEMPTS=30
MAX_UPLOAD_RETRY_DELAY=3

# --- DeepSeek: генерация сказки --------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=60
# Лимит токенов ответа. В счёт идут и токены размышлений reasoning-модели,
# поэтому значения в 4096 при 12 страницах длинного текста не хватало:
# обрыв выглядел бы как «модель не выдала схему», и клиент теперь называет
# эту причину прямо.
DEEPSEEK_MAX_TOKENS=8192

# --- RouterAI: генерация иллюстраций ---------------------------------
# Пустой ROUTERAI_API_KEY включает MockImageProvider (картинки без выплат).
ROUTERAI_API_KEY=
ROUTERAI_BASE_URL=https://routerai.ru/api/v1
ROUTERAI_IMAGE_MODEL=google/gemini-3.1-flash-lite-image
ROUTERAI_TIMEOUT=120

# --- RouterAI: озвучка сказки (TTS) ----------------------------------
# Тот же ключ и базовый URL, что у картинок. Модели Gemini TTS отдают
# только PCM, поэтому провайдер сам оборачивает поток в WAV, а ffmpeg
# (см. Dockerfile/README) кодирует итог в mp3.
ROUTERAI_NARRATION_MODEL=google/gemini-3.8-flash-tts
ROUTERAI_NARRATION_VOICE_FEMALE=Kore
ROUTERAI_NARRATION_VOICE_MALE=Charon
# Манера чтения передаётся в provider.options: Gemini читает текст дословно
# и озвучил бы режиссёрское указание вслух.
ROUTERAI_NARRATION_STYLE=тепло и неторопливо, как рассказчик детских сказок
ROUTERAI_NARRATION_TIMEOUT=180
ROUTERAI_NARRATION_RETRIES=2
# Предел одновременных запросов только для страховочной нарезки длинного
# текста: обычная сказка синтезируется одним запросом.
ROUTERAI_NARRATION_CONCURRENCY=3

# --- Хранение ---------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./bot.db
UPLOADS_DIR=uploads

# --- Валидация фото ---------------------------------------------------
PHOTO_MAX_SIZE_MB=10
PHOTO_MIN_SIDE_PX=300
PHOTO_ASPECT_MIN=0.4
PHOTO_ASPECT_MAX=2.5

# --- Логирование ------------------------------------------------------
LOG_LEVEL=INFO

# --- Пайплайн сказок (app/story_pipeline) -----------------------------
STORY_DEFAULT_PAGES=6
STORY_PAGES_MIN=1
STORY_PAGES_MAX=12
# Бюджет иллюстраций: сколько страниц получают картинку. 0 отключает
# ограничение — иллюстрируются все страницы (прежнее поведение, нужно для
# разработки и приёмки). Значение не меньше STORY_DEFAULT_PAGES означает то
# же самое. При 6 страницах и бюджете 3 набор — обложка, пред-финал и финал.
STORY_ILLUSTRATED_PAGES=3
# Диапазон объёма страницы сказки В СЛОВАХ: сколько минимум и сколько
# максимум. Задан числом слов, а не числом предложений, потому что модель
# считает предложения неточно, а слова код умеет посчитать и проверить.
# Нижняя граница проверяется: страница короче уходит в один корректирующий
# перезапрос, а если и после него — в `story.json` как деградация (книжка
# при этом всё равно доставляется). Числа подбираются на живых прогонах
# через эти переменные, без правки кода; MAX не меньше MIN.
STORY_PAGE_WORDS_MIN=60
STORY_PAGE_WORDS_MAX=120
STORY_MAX_REVISIONS=2
# Рассказчик сказки: first_person (игрушка сама себя представляет) или
# third_person_limited (третье лицо с фокалом на игрушке). Меняет манеру
# текста и формулировки промптов; на иллюстрации не влияет.
STORY_NARRATOR=first_person
STORY_AGE_MIN=3
STORY_AGE_MAX=6
STORY_IMAGE_ASPECT_RATIO=4:3
STORY_OUTPUT_DIR=output
